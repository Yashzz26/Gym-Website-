# ==============================================================
# Gym Management System — Client Environment Variables Example
# ==============================================================
# Copy this file to client/.env and fill in your Firebase
# project's web config values (these are PUBLIC keys — safe
# to include in the browser bundle, but keep this file local).
# ==============================================================

# Firebase Client SDK (public config)
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay Key ID (public — used only for Razorpay Checkout JS)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
