{
  "name": "gym-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Gym Management System — Monorepo workspace for React client and Express server",
  "scripts": {
    "lint:client": "npm --prefix client run lint",
    "test:client": "npm --prefix client test",
    "test:server": "npm --prefix server test",
    "test": "npm run test:client && npm run test:server",
    "lint": "npm run lint:client",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client"
  },
  "lint-staged": {
    "client/src/**/*.{js,jsx}": [
      "oxlint client/src"
    ]
  }
}
