# ==============================================================
# Gym Management System — Environment Variables Example
# ==============================================================
# Copy this file to .env (server) and fill in real values.
# NEVER commit .env with real credentials to version control.
# ==============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development
LOG_FORMAT=dev # 'dev' for colorized console output, 'json' for production structured logs

# Allowed frontend origin(s) for CORS (comma-separated if multiple, no trailing slash)
CORS_ORIGIN=http://localhost:5173

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes window in milliseconds
RATE_LIMIT_MAX=100           # Maximum requests per IP per window

# ---- Firebase Admin SDK (Server-side only) ----
# Option A: Paste the entire service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID",...}

# Option B: Path to service account key file (alternative to above)
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Razorpay (Server-side only) ----
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- Meta WhatsApp Business Cloud API (Server-side only) ----
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ---- QR Token Settings ----
QR_TOKEN_EXPIRY_SECONDS=300
